# ── Empathon Autos ── Environment Variables
# Copy this file to .env and fill in your values.

# Supabase (Required — app won't work without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry (Optional — error monitoring)
VITE_SENTRY_DSN=https://your-dsn@oXXXX.ingest.sentry.io/XXXXX

# Site URL (Used for sitemap generation and canonical URLs)
VITE_SITE_URL=https://www.emphatonautos.com

# Server-only key for admin scripts (NEVER prefix with VITE_ — it would ship to the browser)
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive folder holding the car photos (must be "Anyone with the link — Viewer")
DRIVE_FOLDER_ID=1PisOqp8v8cH4Xb5HSP4pmHx8DKsY0MdU
